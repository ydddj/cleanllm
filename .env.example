LOG_LEVEL=WARNING
LOG_MAX_BYTES=5242880
MODEL_CACHE_TTL=60
CONNECTIVITY_INTERVAL_MINUTES=10
ROUTE_AFFINITY_MINUTES=15
CIRCUIT_BREAKER_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
ALERT_WEBHOOK_URL=
